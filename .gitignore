# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# ---------------------------------------------------------------------------
# dependencies / build output
# ---------------------------------------------------------------------------
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
/coverage
/.next/
/out/
/build
*.tsbuildinfo
next-env.d.ts

# ---------------------------------------------------------------------------
# secrets — nothing env-shaped ever enters this repo
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem

# ---------------------------------------------------------------------------
# QA OUTPUTS are ignored; QA SCRIPTS are committed deliverables.
#
# Kept: visual-check, parity, asset-audit, preflight, lighthouse,
#       benchmark-shots, design-shots (.mts) and grade / grade-diff (.ps1).
# Ignored: everything those scripts *produce*.
# ---------------------------------------------------------------------------
/qa/screenshots/
/qa/lighthouse/
/qa/direction/
/qa/grade-reference/
/qa/*.log
/qa/*.err

# Reference captures of a third-party site. STUDY MATERIAL ONLY — these are
# someone else's work and must never be published or redistributed.
/qa/benchmark/

# ---------------------------------------------------------------------------
# client-supplied footage, not ours to publish
# ---------------------------------------------------------------------------
/content/video-inbox/*
!/content/video-inbox/README.md

# ---------------------------------------------------------------------------
# misc
# ---------------------------------------------------------------------------
.DS_Store
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.vercel

# ---------------------------------------------------------------------------
# NOTE: /public/images/graded/ is deliberately COMMITTED.
#
# The site resolves every content image through the graded tree, and the grade
# pipeline is PowerShell — a Linux deploy build cannot regenerate it. Without
# these files a deploy serves broken images. Regenerate and recommit after any
# regrade: powershell -File qa/grade.ps1 -Grade B
# ---------------------------------------------------------------------------

.vercel
.env*

# ---------------------------------------------------------------------------
# headless autonomous chain (run-until-credits.ps1)
# The script itself and RUN-BRIEF.md are committed; its runtime output is not.
# ---------------------------------------------------------------------------
run-chain.log
RUN-COMPLETE.flag

# Scratch for the beauty-pass sourcing run: API results, candidate previews and
# the download plan. The masters that ship live in assets-src/sourced/ and the
# provenance that matters is in content/photo-credits.json.
.sourcing/
